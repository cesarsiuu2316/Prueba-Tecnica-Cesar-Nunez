# Copy to .env and adjust as needed.

# Corpus location (relative to repo root or absolute)
DOCS_DIR=docs

# Vector store (ChromaDB, persistent)
CHROMA_DIR=docs/chroma-db
CHROMA_COLLECTION=ChromaDB_collection_for_corpus

# Local embedding model (HuggingFace / sentence-transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Retrieval
TOP_K=4
# Minimum cosine similarity (1 - distance) for a chunk to count as relevant.
SIMILARITY_THRESHOLD=0.4

# Structure-aware chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=200